# a) Climatic Zones (IDAE-INE 2023) ----

# Read external file
# !! Very important: file provided under a confidentiality agreement
# Do not distribute it under any circumstance

zc_path <- paste0(path, "/ZC/ZC_ECV2023.txt")
zc      <- read.csv(zc_path, header = TRUE, sep = ",", stringsAsFactors = FALSE)

head(zc) # Each observation's information is on a single row, need to trim it

# Transform "zc" to a vector
raw_col   <- zc[[1]] 

# Create column in "zc" with the Climatic Zone letter/code
zc$zc     <- substr(raw_col, nchar(raw_col), nchar(raw_col))

# Same with household ID
zc$DB030  <- trimws(substr(raw_col, 1, nchar(raw_col) - 1)) 

# Rejoin in "zc" object
zc        <- zc[, c("zc", "DB030")]
zc$DB030  <- as.numeric(zc$DB030) # Ensure DB030 is numeric

# Checks
head(zc) # of the final structure
table(zc$zc) # of the distribution of counts

# According to INE's e-mail (28.07.2025):
# "a" is the "climatic zone "alpha", that is, Canary Islands
# 9 observations are NA's (17)

# See pg. 34 of the report for more information on their definition:
# https://www.miteco.gob.es/content/dam/miteco/es/prensa/estrategianacionalcontralapobrezaenergetica2019-2024_tcm30-496282.pdf
# !!! they relate to winter's severity, not summer

# alpha: Canarias
# A "(Cálida en invierno): Mediterráneo costero"
# B "(Moderada en invierno): Zonas intermedias del litoral"
# C "(Suave): Clima templado"
# D "(Fría en invierno): Meseta, zonas interiores"
# E "(Muy fría): Regiones de montaña"

sum(is.na(zc$zc))
zc$zc[zc$zc == 9] <- NA # Remove NA's
table(zc$zc) # Check
data <- left_join(data, zc, by = "DB030") # Merge "zc" with previous data object
sum(is.na(data$zc))

# From 17 to 18 NA's. Why?
anti_join(data, zc, by = "DB030")
setdiff(unique(data$DB030), unique(zc$DB030))

# One observation (DB030 ==1) could not be assigned to any climatic zone
# Is treated as NA. To control removed observations, we create:

removed_dataset <- (sum(is.na(data$zc)) / nrow(data)) * 100
removed_weighted <- (sum(data$weight[is.na(data$zc)]) / sum(data$weight)) * 100

removed_dataset # 0.06%
removed_weighted # 0.08%

remove("zc", "zc_path", "raw_col") # Clean environment
gc() # Keep memory usage low


