twoadults    = ifelse(any(HX060 %in% c(7, 8, 11, 12, 13)), 1, 0),
otherhhtypes = ifelse(any(HX060 %in% c(9, 14)), 1, 0),
kids         = ifelse(any(HX060 %in% c(10, 11, 12, 13, 14)), 1, 0),
sqmeters     = as.numeric(HC020),
sqmeteroom   = as.numeric(HH030) / as.numeric(HC020),
pollution    = ifelse(any(HS180 == 1), 1, 0),
vhRentaa     = as.numeric(vhRentaa),
# Recode HC003 values to create our independent variable, 'count'
count        = case_when(
HC003 == 1  ~ 3,
HC003 == 2  ~ 2,
HC003 == 3  ~ 1,
HC003 == 4  ~ 0,
HC003 == 99 ~ NA_real_,
TRUE         ~ NA_real_
)
)
individual <- individual %>%
dplyr::select(
RB030,  # Individual identifier (DB030 + two individual digits)
RB050,  # Weights
RB082,  # Age at the time of the interview
RB090,  # Sex
RB211,  # Situation in the activity in the actuality
PL141,  # Type of contract (labor)
PE041   # Level of education completed
) %>%
# Create household identifier from "RB030" by removing the last two digits
dplyr::mutate(
DB030 = substr(RB030, 1, nchar(RB030) - 2),  # Extract household identifier
DB030 = as.numeric(DB030) # Convert to numeric to remove leading zeros
) %>%
# Group by household identifier
group_by(DB030) %>%
# Create household-level variables inside summarize()
dplyr::summarize(
# Weight:
weight          = first(as.numeric(RB050)),
# Mean age of adults (age >= 18)
meanageadults   = ifelse(sum(RB082 >= 18) == 0, 0, mean(RB082[RB082 >= 18])),
# Proportion of male adults (age >= 18)
propmale        = ifelse(sum(RB082 >= 18) == 0, 0, sum(RB090 == 1 & RB082 >= 18) / sum(RB082 >= 18)),
# Income stability: 1 if any member has RB211 == 3 or 4, or PL141 == 21 or 22
incomestability = ifelse(all(RB211 %in% c(3, 4), na.rm = TRUE) | all(PL141 %in% c(21, 22), na.rm = TRUE), 1, 0),
# All members in the household have high education (PE041 == 500)
allhigheducation = ifelse(all(PE041 == 500, na.rm = TRUE), 1, 0)
) %>%
# Ungroup after summarizing to get a tidy dataframe
ungroup()
# Merge "household" and "individual" data objects
data <- left_join(household, individual, by = c("DB030", "weight"))
# [5] PREVIOUS CHECKS FOR THE MODEL TO RUN ###################################
## [i] NA'S analysis in the independent variables ----
# Percentage of observations with NA's:
(sum(rowSums(is.na(data)) > 0) / nrow(data)) * 100  # 7.65%
# Variables with NA's:
colSums(is.na(data[, !names(data) %in% "count"]))
# There are two groups of variables with NA's:
# First: Three vars ("detached", "semidetached", "flatless10", flatmore10") with 51 NA's. They are the same:
na_rows        <- data[is.na(data$detached) | is.na(data$semidetached) |
is.na(data$flatless10) | is.na(data$flatmore10), ]
identical_rows <- apply(na_rows[, c("detached",
"semidetached",
"flatless10",
"flatmore10")], 1,
function(x) all(is.na(x)))
sum(identical_rows)                # They are
(nrow(na_rows) / nrow(data)) * 100 # They account for the 0.18% of the dataset
# SHOULD WE REMOVE THEM?
# Second group: "sqmeters" (1583), "sqmeteroom" (1639) and "pollution" (123)
# A) "sqmeters":
sum(is.na(household$sqmeters))               # 1583 NA's before merging
sum(is.na(data$sqmeters)) / nrow(data) * 100 # Account for 5.81%
data <- data[!is.na(data$sqmeters), ]        # SHOULD WE REMOVE THEM?
# B) "sqmeteroom":
sum(is.na(household$sqmeteroom))               # 1639 NA's after merging
sum(is.na(data$sqmeteroom)) / nrow(data) * 100 # Account for 6.02%
data <- data[!is.na(data$sqmeteroom), ]        # SHOULD WE REMOVE THEM?
# C) "pollution"
sum(is.na(household$pollution))               # 123 NA's before merging
sum(is.na(data$pollution)) / nrow(data) * 100 # Account for 0.45%
data <- data[!is.na(data$pollution), ]        # SHOULD WE REMOVE THEM?
## [ii] NA'S analysis in the dependent variable ----
sum(is.na(data$count))                      # 331 NA's
sum(is.na(data$count)) / nrow(data) * 100   # Account for the 1.22%
data <- data[!is.na(data$count), ]          # For the moment, we remove them
######### ANALYSIS OF THE MEAN AND VARIANCE
mean(data$count) # 0.202149
var(data$count)  # 0.2812387
######### PROPORTION OF ZERO'S (not weighted)
mean(data$count == 0)                                   # Not weighted: 85.66%
sum((data$count == 0) * data$weight) / sum(data$weight) # Weighted:     84.64%
######### DISPERSION TEST (library)
dispersiontest(glm(count ~ 1, family = poisson, data = data))
# dispersion: 1.391193
# p-value:   <2.2e-16
# Overdispersion (variance greater than the mean)
## [iii] Plot of the independent variable (weighted) ----
ggplot(data,
aes(x = factor(count), weight = weight)) +
geom_bar(aes(y = (..count..) / sum(..count..) * 100),
fill = "steelblue",
color = "black") +
geom_text(
aes(
y = (..count..) / sum(..count..) * 100,
label = sprintf("%.1f%%", (..count..) / sum(..count..) * 100)
),
stat = "count",
vjust = -0.5,
color = "black"
) +
labs(
title = "Weighted Histogram of Count (Renovation/Retrofits)",
x     = "Number of Renovations/Retrofits",
y     = "% Total Population"
) +
scale_x_discrete(labels = c("0", "1", "2", "3 or more")) +
scale_y_continuous(labels = percent_format(scale = 1), limits = c(0, 95)) +
theme_minimal()
# 85.7%: 0
# 10.9%: 1
# 2.4%:  2
# 1.0%:  3 or more
# Proportion of not-zero counts: 14.3%
