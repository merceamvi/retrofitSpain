## [ii] Non-binary  variables ----
# Extract the data for the specified variables
not_binary_data <- survey_result_list[c("propmale",
"meanageadults",
"vhRentaa",
"sqmeteroom",
"sqmeters",
"rooms")]
not_binary_vars <- c("propmale", "meanageadults", "vhRentaa", "sqmeteroom", "rooms")
# Empty list to store results
descriptive_stats_list <- list()
# Loop through each non-binary variable and calculate descriptive statistics
for (var_name in not_binary_vars) {
# Calculate the weighted mean for each variable
mean_val <- svymean(as.formula(paste("~", var_name)),
design = survey_design, na.rm = TRUE)
# Calculate the weighted standard deviation (sqrt of variance)
var_val <- svyvar(as.formula(paste("~", var_name)),
design = survey_design, na.rm = TRUE)
sd_val <- sqrt(var_val)  # Standard Deviation
# Calculate the weighted median (50th percentile)
median_val <- svyquantile(as.formula(paste("~", var_name)),
design = survey_design, c(0.5), na.rm = TRUE)
# Calculate the minimum and maximum values from raw data
min_val <- min(data[[var_name]], na.rm = TRUE)  # Min based on raw data
max_val <- max(data[[var_name]], na.rm = TRUE)  # Max based on raw data
# Store all the results in the list for each variable
descriptive_stats_list[[var_name]] <- list(
Mean = mean_val,
Median = median_val,
St_Dev = sd_val,
Min = min_val,
Max = max_val
)
}
# To view the statistics
descriptive_stats_list$meanageadults
descriptive_stats_list$vhRentaa
descriptive_stats_list$sqmeteroom
descriptive_stats_list$sqmeters
descriptive_stats_list$rooms
# [7] INITIAL BINARY LOGIT MODEL FOR COMPARISON ----
# Clean environment (everything but:)
rm(list = setdiff(ls(), c("data", "path")))
# To check if the hurdle models are working properly (should be the same)
# To do so, using "I(count > 0)" we transform the "count" into a binary variable
summary(bin.logit <- glm(I(count > 0) ~ rental
# + vhRentaa # Problems scale
+ ownership
+ detached
+ semidetached
+ flatless10
+ rooms
+ oneadult
+ twoadults
+ kids
+ sqmeters
+ pollution
+ meanageadults
+ propmale
+ incomestability
+ allhigheducation,
data    = data,
family  = binomial(link = "logit"),
weights = data$weight/1000))
# [8] EXPLORATORY MODELS ----
## [i] POSSION HURDLE (PH) MODEL -----
summary(ph.model <- hurdle(count ~ rental
# + vhRentaa
+ ownership
+ detached
+ semidetached
+ flatless10
+ rooms
+ oneadult
+ twoadults
+ kids
+ sqmeters
+ pollution
+ meanageadults
+ propmale
+ incomestability
+ allhigheducation,
data      = data,
dist      = "poisson",
zero.dist = "binomial",
link      = "logit",
weights   = data$weight/1000))
## [ii] NEGATIVE BINOMIAL HURDLE (NBH) MODEL ----
summary(nbh.model <- hurdle( count ~ rental
# + vhRentaa
+ ownership
+ detached
+ semidetached
+ flatless10
+ rooms
+ oneadult
+ twoadults
+ kids
+ sqmeters
+ pollution
+ meanageadults
+ propmale
+ incomestability
+ allhigheducation,
data      = data,
dist      = "negbin",
zero.dist = "binomial",
link      = "logit",
weights   = data$weight/1000))
## [iii] ZERO-INFLATED POSSON (ZIP) ----
summary(zip.model <- zeroinfl(count ~ rental
# + vhRentaa
+ ownership
+ detached
+ semidetached
+ flatless10
+ rooms
+ oneadult
+ twoadults
+ kids
+ sqmeters
+ pollution
+ meanageadults
+ propmale
+ incomestability
+ allhigheducation,
data      = data,
dist      = "poisson",
link      = "logit",
weights   = data$weight/1000))
## [iv] ZERO-INFLATED NEGATIVE BINOMIAL (ZINB) ----
summary(zinb.model <- zeroinfl(count ~ rental
# + vhRentaa
+ ownership
+ detached
+ semidetached
+ flatless10
+ rooms
+ oneadult
+ twoadults
+ kids
+ sqmeters
+ pollution
+ meanageadults
+ propmale
+ incomestability
+ allhigheducation,
data    = data,
dist    = "negbin",
link    = "logit",
weights = data$weight/1000))
# [9] COMPARISON OF MEASURES OF GOODNESS OF FIT ----
cbind(AIC(nbh.model, ph.model, zinb.model, zip.model),
BIC(nbh.model, ph.model, zinb.model, zip.model),
logLik(nbh.model, ph.model, zinb.model, zip.model))
# Extract mean (mu) and theta
mu    <- mean(nbh.model$fitted.values)
theta <- nbh.model$theta
# Calculate variance-to-mean ratio
VMR <- 1 + (mu / theta)
VMR
# 1.024817
# [10] PREDICTION OF PROBABILITIES TO OBSERVE A SPECIFIC NUMBER OF RETROFITS ----
obs.prob <- c(sum(data$count == 0),
sum(data$count == 1),
sum(data$count == 2),
sum(data$count == 3)
) / length(data$count)
nbh.prob <- colSums(predprob(nbh.model))/length(data$count)
ph.prob <- colSums(predprob(ph.model))/length(data$count)
zinb.prob <- colSums(predprob(zinb.model))/length(data$count)
zip.prob <- colSums(predprob(zip.model))/length(data$count)
preds <- data.frame(cbind(obs.prob, nbh.prob, ph.prob, zinb.prob, zip.prob))
# Create a first line
plot(0:3, obs.prob,
type = "b",
frame = FALSE,
pch = 1,
col = "black",
xlab = "Number of retrofits",
ylab = "Probability")
# Add a second line
lines(0:3, nbh.prob, pch=18, col="red", type = "b", lty=2)
lines(0:3, ph.prob, pch=18, col="blue", type = "b", lty=2)
lines(0:3, zinb.prob, pch=18, col="darkorchid", type = "b", lty=2)
lines(0:3, zip.prob, pch=18, col="green", type = "b", lty=2)
# Add a legend to the plot
legend("topright",
legend=c("Observed", "Negative Binomial Hurdle", "Poisson Hurdle", "Zero Inflated NB", "Zero Inflated Poisson"),
col=c("black", "red", "blue", "darkorchid", "green"),
lty=c(1,2,2,2,2),
cex=0.5)
