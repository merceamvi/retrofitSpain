# Create a "survey" object
survey_design <- svydesign(id      = ~1,      # No clustering
weights = ~weight, # Weights column
data    = data)    # Dataset
# Empty list to store results
survey_result_list <- list()
# Loop through all variables except 'count'
for(var_name in setdiff(names(data), "count")) {
# Create the weighted contingency table
survey_table <- svytable(as.formula(paste("~", var_name, "+ count")),
design = survey_design)
# Normalize the table to get row percentages
normalized_table <- prop.table(survey_table, margin = 1) * 100
# Store the result in the list
survey_result_list[[var_name]] <- normalized_table
}
