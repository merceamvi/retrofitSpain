  # columna de dimensión (Dim.1 o Dim 1)
  dim_col <- names(Q)[grepl(paste0("^Dim[\\. ]", dim, "$"), names(Q))]
  if (length(dim_col) == 0) stop("No encuentro la columna de la dimensión en las coordenadas.")
  dim_col <- dim_col[1]
  
  Q %>%
    arrange(desc(abs(.data[[dim_col]]))) %>%
    select(cat, !!dim_col) %>%
    head(n)
}

