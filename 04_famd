get_quali_coord <- function(res){
  if (!is.null(res$quali.var) && !is.null(res$quali.var$coord)) return(res$quali.var$coord)
  if (!is.null(res$quali)     && !is.null(res$quali$coord))     return(res$quali$coord)
  if (!is.null(res$var)       && !is.null(res$var$coord))       return(res$var$coord)
  stop("No encuentro coordenadas de cualitativas activas en res_famd.")
}

