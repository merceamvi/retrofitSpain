# FUNCTION TO SUMMARIZE AND TEST RESIDUALS BY BINARY GROUP

summarize_residuals <- function(resid, group, group_labels, var_name) {
  # Ensure group is numeric 0/1
  group <- as.numeric(group)
  
  df <- data.frame(
    variable = var_name,
    group    = group_labels,
    n        = sapply(0:1, function(x) sum(group == x)),
    mean     = sapply(0:1, function(x) mean(resid[group == x], na.rm = TRUE)),
    median   = sapply(0:1, function(x) median(resid[group == x], na.rm = TRUE)),
    sd       = sapply(0:1, function(x) sd(resid[group == x], na.rm = TRUE)),
    q75      = sapply(0:1, function(x) unname(quantile(resid[group == x], 0.75, na.rm = TRUE))),
    q95      = sapply(0:1, function(x) unname(quantile(resid[group == x], 0.95, na.rm = TRUE)))
  )
  
  # Difference in means
  diff_mean <- df$mean[1] - df$mean[2]
  
  # t-test
  test <- t.test(resid[group == 0], resid[group == 1])
  
  cat("RESIDUAL ANALYSIS:", var_name, "\n")
  
  print(df[, -1], row.names = FALSE)
  cat("\nDifference (", group_labels[1], "-", group_labels[2], "): ", round(diff_mean, 4), "\n", sep = "")
  cat("T-test for difference in mean squared residuals:\n")
  cat("  t-statistic:", round(test$statistic, 4), "\n")
  cat("  p-value:", format.pval(test$p.value, digits = 4), "\n")
  if(test$p.value < 0.05) {
    cat("  Result: SIGNIFICANT difference - residuals are larger in",
        ifelse(diff_mean > 0, group_labels[1], group_labels[2]), "group\n\n")
  } else {
    cat("  Result: NO significant difference\n\n")
  }
  
  return(df)
}

