# 9. BOOTSTRAPPED AVERAGE MARGINAL EFFECTS (AME) 
###############################################################################
# Binary variables: Discrete change (0 to 1)
# Continuous variables: Average derivative across all observations
###############################################################################

set.seed(123)
n_bootstrap <- 1000

# Fit original model
model_original <- glm(formula = as.formula(paste("retrofit ~", vars_formula)),
                      family  = binomial(link = "logit"),
                      data    = data_clean,
                      weights = weights_normalised)

# Storage for bootstrap results
bootstrap_ame <- list()
for (var in vars) {
  bootstrap_ame[[var]] <- numeric(n_bootstrap)
}

# Bootstrap loop
for (b in 1:n_bootstrap) {
  
  # Sample with replacement (preserve weights)
  boot_idx     <- sample(1:nrow(data_clean), size = nrow(data_clean), replace = TRUE)
  data_boot    <- data_clean[boot_idx, ]
  weights_boot <- weights_normalised[boot_idx]
  
  # Estimate model on bootstrap sample
  model_boot <- glm(formula = as.formula(paste("retrofit ~", vars_formula)),
                    family  = binomial(link = "logit"),
                    data    = data_boot,
                    weights = weights_boot)
  
  coef_boot <- coef(model_boot)
  
  # Compute AME for each variable
  for (var in vars) {
    
    # Check if variable is binary
    unique_vals <- unique(data_boot[[var]][!is.na(data_boot[[var]])])
    is_binary   <- (length(unique_vals) == 2 && all(sort(unique_vals) == c(0, 1))) || 
      is.factor(data_boot[[var]])
    
    if (is_binary) {
      
      # BINARY VARIABLE: Discrete change P(Y=1|X,D=1) - P(Y=1|X,D=0)
      # Average over all observations
      
      data_0 <- data_boot
      data_0[[var]] <- 0
      pred_0 <- predict(model_boot, newdata = data_0, type = "response")
      
      data_1 <- data_boot
      data_1[[var]] <- 1
      pred_1 <- predict(model_boot, newdata = data_1, type = "response")
      
      # Average discrete change
      bootstrap_ame[[var]][b] <- mean(pred_1 - pred_0, na.rm = TRUE)
      
    } else {
      
      # CONTINUOUS VARIABLE: Average derivative β × mean[ŷ(1-ŷ)]
      # This is the proper AME for continuous variables
      
      pred_prob <- predict(model_boot, newdata = data_boot, type = "response")
      
      # ME = β × average of [p(1-p)] across all observations
      avg_derivative <- mean(pred_prob * (1 - pred_prob), na.rm = TRUE)
      bootstrap_ame[[var]][b] <- coef_boot[var] * avg_derivative
    }
  }
  
  # Progress indicator
  if (b %% 100 == 0) {
    cat("Completed", b, "iterations\n")
  }
}

