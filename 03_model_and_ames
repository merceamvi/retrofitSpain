# b) Bootstrap statistic function
boot_fun <- function(d, idx) {
  # Resample rows
  d2 <- d[idx, ]
  
  # Refit weighted logit
  m <- glm(
    retrofit ~ . - weights,
    data    = d2,
    weights = d2$weights,
    family  = binomial(link = "logit")
  )
  
  # Return coefficients
  return(coef(m))
}

