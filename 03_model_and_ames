  # Draw point estimate
  points(ame_plot$estimate[i], i, 
         pch = pch_i, 
         col = col_i, 
         cex = 1.3,
         lwd = 2)
  
  # Add text: AME value [CI_lower, CI_upper] in percentage points
  combined_text <- sprintf("%.2f [%.2f, %.2f]", 
                           ame_plot$estimate[i],
                           ame_plot$ci_lower[i], 
                           ame_plot$ci_upper[i])
  
  text(x_max + 0.3, i, 
       combined_text, 
       pos = 4, 
       cex = 0.7, 
       col = col_i,
       xpd = TRUE)  # Allow text outside plot region
}

