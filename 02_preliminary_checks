# ======================= 1. CORRELATION MATRICES ==============================

# We need to ensure that multicolinearity issues are minimised, both within and
# between the mean equation and the scale equation variables

# The check is done separatedly for the whole set of variables first, and 
# then for the HDD/CDD ones for clarity

names(data) # Explore variable names
numeric_data <- data[sapply(data, is.numeric)] # Select only numeric vars
cor_matrix <- cor(numeric_data, use = "pairwise.complete.obs") # Compute matrix

# Convert correlation matrix to long format (pairs)
cor_matrix <- as.data.frame(as.table(cor_matrix)) %>% 
  rename(var1 = Var1, 
         var2 = Var2, 
         correlation = Freq) %>%
  filter(var1 != var2) %>%  # remove self-correlations for clarity
  mutate(abs_correlation = abs(correlation)) %>%
  filter(abs_correlation >= 0.5) %>%  # keep only >=0.5 abs(corr) values
  arrange(desc(abs_correlation))  # sort descending

# i) Corr matrix (all but HDD/CDD)
cor_matrix_vars <- cor_matrix %>%
  rowwise() %>%
  mutate(pair = paste(sort(c(var1, var2)), collapse = "_")) %>%
  distinct(pair, .keep_all = TRUE) %>%
  filter(
    !(grepl("^HDD", var1) & grepl("^HDD", var2)) & # exclude HDD
    !(grepl("^CDD", var1) & grepl("^CDD", var2)) # exclude CDD
  ) %>%
  dplyr::select(-pair)

# ii) Corr matrix (HDD vs. CDD) 
cor_matrix_dd <- cor_matrix %>%
  rowwise() %>%
  mutate(pair = paste(sort(c(var1, var2)), collapse = "_")) %>%
  distinct(pair, .keep_all = TRUE) %>%
  # keep only combinations where one is HDD and the other is CDD:
  filter(
    (grepl("^HDD", var1) & grepl("^CDD", var2)) |
      (grepl("^CDD", var1) & grepl("^HDD", var2))
  ) %>%
  dplyr::select(-pair)

# Analysis of cor_matrix_vars (>= 0.5):
