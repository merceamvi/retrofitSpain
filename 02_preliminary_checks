# ======================= 2. ONE-WAY ANOVA eta^2 ===============================

# We do know that INE's climatic zones (CZ) represent the severity of the
# winter, rather than the severity of the summer conditions

# HDD/CDD are defined at NUTS2 levels (CCAA) and climatic zones not (more
# granular)

# Therefore, in this block we assess the possibility of introducing CZ joint
# with CDD to represent i) both climatic metrics ii) both spatial dimensions

# To do so, we use one-way ANOVA eta-squared metric to assess potential 
# redundancy between CZ and CDD (we compute it to HDD and NUTS2 also). 
# The metric captures the part of variance explained by data$zc in the other 
# vars and it is used as a diagnostic of informational overlap (not as a test)

numeric_vars <- names(data[sapply(data, is.numeric)]) # Extract names

etas <- sapply(numeric_vars, # Loop over numeric variables
               function(x)  # For each variable x,
                 EtaSq(aov(data[[x]] ~ data$zc), # Estimate 1-w ANOVA with CZs
                       type = 1) # Compute eta^2 (share of variance explained)
        )[1, ] # Extract eta^2

etas <- etas[!is.na(etas)] # Remove NaN's
etas <- etas[abs(etas) >= 0.5] # Keep only >= 0.5 (abs)

print(etas <- data.frame(
  variable    = names(etas),
  eta_squared = etas,
  row.names   = NULL  # ensure no problematic rownames
) %>%
  arrange(desc(eta_squared)) # arrange in descending order
  )

# Climatic zones explain >=0.5 variance of:
# Most HDD metrics (as expected)
# Canary Islands NUTS2 - Expected for "alpha" special CZ of the region


